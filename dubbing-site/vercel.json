{
  "functions": {
    "api/engine.js": { "includeFiles": "engine/**" },
    "api/health.js": { "includeFiles": "engine/**" }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
